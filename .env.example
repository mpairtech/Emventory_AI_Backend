# =========================
# Emventory AI Backend (.env template)
# =========================

# Optional: YAML defaults (these do NOT override env/.env)
# APP_ENV=local            # loads config/local.yaml
# APP_ENV=prod             # loads config/prod.yaml
# APP_CONFIG_FILE=config/local.yaml

# -------------------------
# Database (Postgres/pgvector)
# -------------------------
# If using docker-compose: DB_HOST=pgvector_db, DB_PORT=5432
# If Postgres is running on host and docker app connects: DB_HOST=host.docker.internal, DB_PORT=5433 (example)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=Search
DB_USER=postgres
DB_PASSWORD=postgres

# -------------------------
# LLM Providers
# -------------------------
# Gemini (required for embeddings / default generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI (used only if ACTIVE_PROVIDER=openai or as fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# LLM provider: gemini | openai
ACTIVE_PROVIDER=openai

# -------------------------
# Logging
# -------------------------
LOG_LEVEL=INFO

# -------------------------
# API authentication
# -------------------------
# Server-side secret used to derive API keys (HMAC). Keep this secret.
API_SECRET=change_me_to_a_long_random_secret

# -------------------------
# Docker Compose helpers (optional)
# -------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=Search

PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin
