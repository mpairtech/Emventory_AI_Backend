# আপনার pgvector Postgres (আলাদা জায়গায় চালু) — এই প্রজেক্টের জন্য কপি করে .env বানান
# cp .env.example .env แล้ว মানগুলো পূরণ করুন

# DB — আপনার postgres: container_name=pgvector_db, DB=Search, port 5433:5432
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=Search
DB_USER=postgres
DB_PASSWORD=your_password_here

# Gemini API (AI search/RAG)
GEMINI_API_KEY=your_gemini_api_key

# Required: server-side secret to generate API keys from user input. Key = HMAC(API_SECRET, input).
# Client sends X-Key-Input (e.g. org_id) and X-API-Key = HMAC(API_SECRET, X-Key-Input).
API_SECRET=your_secret_here

LOG_LEVEL=INFO
